# Ollama on the Intel iGPU (Vulkan) for GLaDOS.
# Install: cp scripts/systemd/*.service scripts/systemd/*.timer ~/.config/systemd/user/ && systemctl --user daemon-reload
#          systemctl --user enable glados.service glados-backup.timer
[Unit]
Description=Ollama (Vulkan iGPU) for GLaDOS

[Service]
Environment=OLLAMA_VULKAN=1 OLLAMA_IGPU_ENABLE=1 OLLAMA_CONTEXT_LENGTH=8192
ExecStart=/usr/bin/ollama serve
Restart=on-failure

[Install]
WantedBy=default.target
